{
  "schemaVersion": "maps.engine-scenario/v1",
  "id": "raster-tile-churn-v1",
  "fixture": {
    "source": "committed-local-xyz-tiles",
    "network": "deterministic-fixture-server"
  },
  "viewport": { "width": 1280, "height": 720, "devicePixelRatio": 1 },
  "initialCamera": { "longitude": 0, "latitude": 0, "zoom": 4, "bearing": 0, "pitch": 0 },
  "journey": [
    { "type": "settle" },
    { "type": "pan-screen", "dx": 960, "dy": 0 },
    { "type": "pan-screen", "dx": 960, "dy": 0 },
    { "type": "reverse-before-idle" },
    { "type": "pan-screen", "dx": -1920, "dy": 0 },
    { "type": "settle" }
  ],
  "observations": [
    "requested-tile-identities",
    "request-priority-order",
    "cancelled-requests",
    "deduplicated-requests",
    "cache-hits",
    "cache-misses",
    "evictions",
    "final-visible-tile-set"
  ],
  "runtimePhases": [
    "visible-tile",
    "schedule",
    "decode-upload",
    "warm-cache"
  ]
}
