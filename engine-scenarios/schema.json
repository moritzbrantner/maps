{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moritzbrantner.github.io/maps/contracts/engine-scenario-v1.schema.json",
  "title": "Maps engine scenario v1",
  "type": "object",
  "required": ["schemaVersion", "id", "observations", "runtimePhases"],
  "properties": {
    "schemaVersion": { "const": "maps.engine-scenario/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$" },
    "fixture": { "type": "object" },
    "viewport": { "type": "object" },
    "initialCamera": { "type": "object" },
    "operations": { "type": "array", "items": { "type": "object" } },
    "journey": { "type": "array", "items": { "type": "object" } },
    "coordinates": { "type": "array" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtimePhases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
