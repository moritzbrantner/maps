# Bundle analysis size limit in KiB.
MAPS_BUNDLE_ANALYSIS_LIMIT=16

# Optional path/package override for the WASM density-kernel package.
MAPS_KERNELS_WASM_PACKAGE=

# Multiplier applied to benchmark budgets.
MAPS_BENCHMARK_BUDGET_MULTIPLIER=1

# Set to 1 to turn benchmark-budget warnings into failures.
MAPS_BENCHMARK_WARN_AS_ERROR=0
