{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": {
      "flat": ["./src/flat-shim.ts"],
      "@moritzbrantner/maps/wasm": ["./src/maps-wasm-unbuilt.ts"],
      "@moritzbrantner/maps/wasm/core": ["./src/maps-wasm-unbuilt.ts"],
      "@moritzbrantner/maps": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "demo/**/*.ts",
    "demo/**/*.tsx",
    "e2e/fixtures/*.ts",
    "e2e/fixtures/*.tsx"
  ],
  "exclude": ["demo/**/*.test.ts"]
}
