{
  "name": "@moritzbrantner/maps",
  "version": "0.1.3",
  "private": false,
  "description": "React map components and temporal geo utilities backed by density-aware aggregation.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/maps.git"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./layers": {
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./flat": {
      "types": "./dist/flat.d.ts",
      "import": "./dist/flat.js"
    },
    "./globe": {
      "types": "./dist/globe.d.ts",
      "import": "./dist/globe.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "bench:heat-map": "bun run ./scripts/benchmark-heat-map.mjs",
    "bench:heat-layer": "bun run ./scripts/benchmark-heat-layer.mjs",
    "bench:performance": "bun run ./scripts/benchmark-performance.mjs",
    "bench:geojson-transition": "bun run ./scripts/benchmark-geojson-transition.mjs",
    "bench:temporal-geojson": "bun run ./scripts/benchmark-temporal-geojson.mjs",
    "dev": "vite --host 0.0.0.0",
    "format": "oxfmt --write demo package.json .oxfmtrc.json",
    "format:check": "oxfmt --check demo package.json .oxfmtrc.json",
    "lint": "node ./scripts/verify-package-imports.mjs ./src @/ next/ && node ./scripts/verify-package-styles.mjs .",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "verify:entry-bundles": "node ./scripts/verify-entry-bundles.mjs",
    "pack:dry": "npm pack --dry-run --ignore-scripts --json",
    "verify:release": "bun run check-types && bun run lint && bun run test && bun run build && bun run verify:entry-bundles && bun run test:browser && bun run bench:temporal-geojson && bun run bench:performance && bun run pack:dry"
  },
  "dependencies": {
    "@moritzbrantner/data-density": "^0.1.1",
    "@moritzbrantner/timeline-editor": "file:../timeline-editor",
    "@moritzbrantner/ui": "https://registry.npmjs.org/@moritzbrantner/ui/-/ui-0.8.0.tgz",
    "@turf/boolean-clockwise": "^7.3.5",
    "@turf/centroid": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.1.14",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@testing-library/react": "^16.3.0",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-geo": "^3.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.184.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.51.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "6.0.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@moritzbrantner/ui": "https://registry.npmjs.org/@moritzbrantner/ui/-/ui-0.8.0.tgz"
  },
  "packageManager": "bun@1.3.12"
}
