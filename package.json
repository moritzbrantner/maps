{
  "name": "@moritzbrantner/maps",
  "version": "0.1.5",
  "private": false,
  "description": "React map components and temporal geo utilities backed by density-aware aggregation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/maps.git"
  },
  "files": [
    "dist",
    "maplibre.css",
    "styles.css",
    "styles.full.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./layers": {
      "types": "./dist/layers.d.ts",
      "import": "./dist/layers.js"
    },
    "./flat": {
      "types": "./dist/flat.d.ts",
      "import": "./dist/flat.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./geojson": {
      "types": "./dist/geojson.d.ts",
      "import": "./dist/geojson.js"
    },
    "./heat": {
      "types": "./dist/heat.d.ts",
      "import": "./dist/heat.js"
    },
    "./measurement": {
      "types": "./dist/measurement.d.ts",
      "import": "./dist/measurement.js"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js"
    },
    "./wasm": {
      "types": "./dist/wasm/maps_wasm.d.ts",
      "import": "./dist/wasm/maps_wasm.js"
    },
    "./package.json": "./package.json",
    "./maplibre.css": "./maplibre.css",
    "./styles.css": "./styles.css",
    "./styles.full.css": "./styles.full.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && bun run build:styles",
    "build:js": "tsup --config tsup.config.ts",
    "build:styles": "node ./scripts/build-styles.mjs",
    "build:wasm": "node ./scripts/build-maps-wasm.mjs",
    "build:package": "bun run build && bun run build:wasm",
    "analyze:bundles": "node ./scripts/analyze-bundles.mjs",
    "bench:heat-map": "bun run ./scripts/benchmark-heat-map.mjs",
    "bench:heat-layer": "bun run ./scripts/benchmark-heat-layer.mjs",
    "bench:scalar-field": "bun run ./scripts/benchmark-scalar-field.mjs",
    "bench:performance": "bun run ./scripts/benchmark-performance.mjs",
    "bench:engine": "node ./scripts/benchmark-engine.mjs",
    "bench:geojson-transition": "bun run ./scripts/benchmark-geojson-transition.mjs",
    "bench:temporal-geojson": "bun run ./scripts/benchmark-temporal-geojson.mjs",
    "dev": "vite --host 0.0.0.0",
    "format": "oxfmt --write demo package.json .oxfmtrc.json",
    "format:check": "oxfmt --check demo package.json .oxfmtrc.json",
    "lint": "bun run lint:static && node ./scripts/verify-package-imports.mjs ./src @/ next/ && node ./scripts/verify-package-styles.mjs . && bun run verify:security-sensitive",
    "lint:static": "oxlint src demo e2e",
    "prepack": "bun run build:package",
    "prepare": "bun ./scripts/prepare-git-install.ts",
    "verify:git-install": "bun ./scripts/verify-git-install.ts",
    "check-types": "tsc --noEmit && tsc -p tsconfig.engine-evidence.json",
    "test": "vitest run",
    "test:tdd": "vitest watch --reporter=verbose",
    "test:tdd:run": "vitest run --bail=1 --reporter=agent",
    "test:tdd:changed": "vitest run --changed --bail=1 --reporter=agent",
    "test:tdd:related": "vitest related --run --bail=1 --reporter=agent",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test --grep @smoke --project=chromium",
    "test:browser:update": "playwright test --update-snapshots",
    "verify:api-surface": "node ./scripts/verify-api-surface.mjs",
    "verify:engine-scenarios": "node ./scripts/verify-engine-scenarios.mjs",
    "verify:engine-camera:prepared": "node ./scripts/verify-engine-camera-parity.mjs",
    "verify:engine-camera": "bun run build:wasm && bun run verify:engine-camera:prepared",
    "verify:engine-browser-evidence": "node ./scripts/verify-engine-browser-evidence.ts",
    "profile:engine-kernels": "bun ./scripts/profile-engine-kernel-evidence.mjs",
    "verify:engine-runtime-evidence": "node ./scripts/verify-engine-runtime-evidence.mjs",
    "verify:security-sensitive": "node ./scripts/verify-security-sensitive-patterns.mjs",
    "verify:audit": "bun audit --audit-level high",
    "verify:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --lib --tests --locked && cargo check -p maps-wasm --target wasm32-unknown-unknown --locked",
    "verify:wasm-package": "bun run build:package && node ./scripts/verify-wasm-package.mjs && bun run verify:engine-camera:prepared",
    "verify:benchmarks": "bun run ./scripts/verify-engine-kernel-budgets.mjs",
    "verify:entry-bundles": "node ./scripts/verify-entry-bundles.mjs",
    "verify:package-consumer": "node ./scripts/verify-package-consumer.mjs",
    "verify:package-size": "node ./scripts/verify-package-size.mjs",
    "pack:dry": "npm pack --dry-run --ignore-scripts --json",
    "verify:agent": "bun run verify:engine-scenarios && bun run check-types && bun run lint && bun run test:tdd:run",
    "verify:fast": "bun run verify:engine-scenarios && bun run check-types && bun run lint && bun run verify:api-surface && bun run test && bun run build:package && bun run verify:entry-bundles && bun run verify:package-consumer && bun run verify:package-size && bun run pack:dry",
    "verify:release": "bun run verify:rust && bun run verify:fast && bun run verify:wasm-package && bun run test:browser && bun run verify:benchmarks && bun run bench:temporal-geojson && bun run bench:performance",
    "bench:engine:interaction": "node ./scripts/benchmark-engine-interaction.mjs",
    "bench:point-journey": "node ./scripts/benchmark-point-journey.mjs",
    "fixture:2d-lab": "bun run ./scripts/export-2d-lab-render-fixture.ts"
  },
  "dependencies": {
    "@turf/boolean-clockwise": "^7.3.5",
    "@turf/centroid": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "d3-delaunay": "^6.0.4",
    "maplibre-gl": "6.4.1",
    "polygon-clipping": "^0.15.7",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@moenarch/editor-core": "git+https://github.com/moritzbrantner/editor-core.git#898f0ab8c61b6188fc87f758d1b057580a683672",
    "@moritzbrantner/timeline-editor": "git+https://github.com/moritzbrantner/timeline-editor.git#79d0a84330ceae8ae52f368f2497468f0a8b9ae5",
    "@moritzbrantner/ui": "git+https://github.com/moritzbrantner/ui.git#a0abbd5821c3e6698c0498059a7fbb0aa86c83d5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@testing-library/react": "16.3.3",
    "@types/d3-delaunay": "6.0.4",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "binaryen": "132.0.0",
    "esbuild": "0.27.7",
    "jsdom": "29.1.1",
    "leaflet": "1.9.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@moritzbrantner/timeline-editor": "^1.0.0",
    "@moritzbrantner/ui": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@moritzbrantner/timeline-editor": {
      "optional": true
    }
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "browserslist": "4.29.4",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "8.5.31",
    "source-map-js": "1.2.2",
    "tinypool": "2.2.0",
    "undici": "7.30.1",
    "vite": "8.3.5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@moenarch/editor-core",
    "@moritzbrantner/timeline-editor",
    "@moritzbrantner/ui"
  ]
}
