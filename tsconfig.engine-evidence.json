{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true
  },
  "include": [
    "scripts/engine-reference/supercluster-aggregation.ts",
    "scripts/install-wasm-bindgen-ci.test.ts",
    "scripts/npm-pack-result.ts",
    "scripts/npm-pack-result.test.ts",
    "scripts/profile-engine-camera-journey.ts",
    "scripts/verify-engine-browser-evidence.ts",
    "scripts/profile-mixed-layer-journey.ts",
    "scripts/verify-engine-mixed-layer-evidence.ts",
    "scripts/profile-heat-scalar-journey.ts",
    "scripts/verify-engine-heat-scalar-evidence.ts",
    "scripts/browser-journey-support.ts",
    "scripts/profile-temporal-playback-journey.ts",
    "scripts/verify-engine-temporal-evidence.ts",
    "scripts/profile-tileset-source-journey.ts",
    "scripts/atlas-tileset-evaluation.ts",
    "scripts/atlas-tileset-evaluation.test.ts",
    "scripts/profile-atlas-tileset-journey.ts",
    "scripts/verify-engine-atlas-tileset-evidence.ts"
  ]
